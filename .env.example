# Flask / SQLAlchemy
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=dev-secret-change-in-production-32char

# Database
DATABASE_URL=sqlite:///lld_platform.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/lld_platform

# Evaluator: "ai" | "rule_based" | "mock"
EVALUATOR_TYPE=rule_based

# OpenAI (only needed when EVALUATOR_TYPE=ai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_TIMEOUT=30

# CORS
FRONTEND_URL=http://localhost:5173

# Request limits
MAX_SUBMISSION_SIZE=50000
